# ==============================================================================
# Konfigurasi Server Backend: isDugem (RantauGuard)
# Salin file ini menjadi .env:
# cp .env.example .env
# ==============================================================================

PROJECT_ID=isdugem_tim_01

MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_KEEPALIVE=60
MQTT_QOS=1

TIMEZONE=Asia/Jakarta
USE_SERVER_CLOCK=false

# Jadwal Waktu (Format HH:MM atau rentang waktu dipisah koma)
KULIAH_WINDOW=08:00-15:00
SHOLAT_WINDOWS=12:00-12:45,15:15-15:45,18:00-18:30,19:15-19:45
MALAM_WINDOW=22:00-05:00

# Titik POI Geofence (UNDIP Tembalang & Semarang Bawah - Format: "lat,lon,radius_m")
POI_KAMPUS=-7.0502,110.4398,150
POI_MASJID=-7.0552,110.4370,100
POI_KOS=-7.0632,110.4385,750
POI_BAR=-6.966984,110.429807,250

ALERT_HEARTBEAT_S=0.0
PING_REPUBLISH=true
LOG_LEVEL=INFO
