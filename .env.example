# ==============================================================================
# Referensi Global Environment: isDugem (RantauGuard)
# Salin file ini menjadi .env pada modul server dan dashboard sesuai kebutuhan.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KREDENSIAL/TOKEN ASLI!
# ==============================================================================

# Identifier Unik Tim (Digunakan sebagai prefix seluruh topik MQTT)
PROJECT_ID=isdugem_tim_01

# Konfigurasi Broker MQTT Publik HiveMQ
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_WS_PORT=8884
MQTT_WSS_URL=wss://broker.hivemq.com:8884/mqtt

# Koordinat Titik Referensi (Geofence POI Semarang: UNDIP Tembalang & Semarang Bawah)
KAMPUS_LAT=-7.0502
KAMPUS_LON=110.4398
KAMPUS_RADIUS_M=150

MASJID_LAT=-7.0552
MASJID_LON=110.4370
MASJID_RADIUS_M=100

# Poros Kos: Mulawarman, Gondang, Banjarsari
KOS_LAT=-7.0632
KOS_LON=110.4385
KOS_RADIUS_M=750

# Poros Bar & Hiburan: Kota Lama (Marabunta, Golden Tiger, HW Tiger) & RedHare Semarang
BAR_LAT=-6.9665
BAR_LON=110.4298
BAR_RADIUS_M=350