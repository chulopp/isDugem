# ==============================================================================
# Referensi Global Environment: isDugem (RantauGuard)
# Salin file ini menjadi .env pada modul server dan dashboard sesuai kebutuhan.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KREDENSIAL/TOKEN ASLI!
# ==============================================================================

# Identifier Unik Tim (Digunakan sebagai prefix seluruh topik MQTT)
PROJECT_ID=isdugem_tim_01

# Konfigurasi Broker MQTT Publik HiveMQ
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_WS_PORT=8884
MQTT_WSS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_USE_TLS=true
MQTT_QOS=1

TIMEZONE=Asia/Jakarta
USE_SERVER_CLOCK=false

# Titik POI Geofence (UNDIP Tembalang & Semarang Bawah - Format: "lat,lon,radius_m")
POI_KAMPUS=-7.0502,110.4398,150
POI_MASJID=-7.0552,110.4370,100
POI_KOS=-7.0632,110.4385,750
POI_BAR=-6.966984,110.429807,250

# Backward compatibility alias
KAMPUS_LAT=-7.0502
KAMPUS_LON=110.4398
KAMPUS_RADIUS_M=150

MASJID_LAT=-7.0552
MASJID_LON=110.4370
MASJID_RADIUS_M=100

KOS_LAT=-7.0632
KOS_LON=110.4385
KOS_RADIUS_M=750

BAR_LAT=-6.966984
BAR_LON=110.429807
BAR_RADIUS_M=250
