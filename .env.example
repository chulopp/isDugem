# ==============================================================================
# Referensi Global Environment — isDugem (RantauGuard)
# Salin file ini menjadi .env pada modul server dan dashboard sesuai kebutuhan.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KREDENSIAL/TOKEN ASLI!
# ==============================================================================

# Identifier Unik Tim (Digunakan sebagai prefix seluruh topik MQTT agar tidak bentrok)
PROJECT_ID=isdugem_tim_01

# Konfigurasi Broker MQTT Publik HiveMQ
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_WS_PORT=8884
MQTT_WSS_URL=wss://broker.hivemq.com:8884/mqtt

# Koordinat Titik Referensi (Geofence POI)
KAMPUS_LAT=-6.9915
KAMPUS_LON=110.4210
KAMPUS_RADIUS_M=150

MASJID_LAT=-6.9930
MASJID_LON=110.4195
MASJID_RADIUS_M=100

KOS_LAT=-6.9940
KOS_LON=110.4225
KOS_RADIUS_M=50

BAR_LAT=-6.9960
BAR_LON=110.4240
BAR_RADIUS_M=100
