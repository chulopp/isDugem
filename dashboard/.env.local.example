# ==============================================================================
# Environment Modul Dashboard — Next.js 14 (RantauGuard)
# Salin file ini menjadi .env.local:
# cp .env.local.example .env.local
# ==============================================================================

# Wajib sama dengan PROJECT_ID di modul server dan edge
NEXT_PUBLIC_PROJECT_ID=isdugem_tim_01

# URL Broker MQTT over WebSocket (WSS HiveMQ Publik)
NEXT_PUBLIC_MQTT_WSS_URL=wss://broker.hivemq.com:8884/mqtt

# Mode Mock Data (true = gunakan data tiruan lokal tanpa koneksi broker)
NEXT_PUBLIC_USE_MOCK=false
